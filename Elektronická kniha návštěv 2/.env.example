# Zkopíruj tento soubor jako ".env" a doplň skutečné hodnoty. Nikdy needituj
# přímo .env.example a nikdy .env necommituj do gitu (obsahuje tajné klíče).

# OCR ------------------------------------------------------------------------
# 0 = obecná extrakce jména/příjmení z libovolné občanky (ZNAMI_LIDE prázdný/
#     vypnutý whitelist). 1 (výchozí v kódu) = pozná jen lidi ze ZNAMI_LIDE
#     v ocr_processor.py, u ostatních vrátí prázdné jméno k ruční opravě.
OCR_STRICT_WHITELIST=0

# SMS notifikace ------------------------------------------------------------
# false (výchozí) = SMS se jen vypíší do konzole/logu (mock, bez Twilio účtu).
# true            = odesílají se opravdové SMS přes Twilio (vyžaduje pip install twilio
#                    a platné údaje níže).
SMS_ENABLED=false

# Minimální počet vteřin mezi dvěma SMS na stejné číslo (rate limiting proti spamu).
SMS_COOLDOWN_SECONDS=10

# Twilio (https://console.twilio.com) – potřeba jen když SMS_ENABLED=true
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# E-mail hostiteli při odbavení na iPad kiosku ------------------------------
# false (výchozí) = e-mail se jen vypíše do konzole/logu (mock, bez účtu u
#                    kterékoli služby).
# true            = odesílá se opravdový e-mail. Přes koho, určuje EMAIL_PROVIDER.
EMAIL_ENABLED=false
EMAIL_PROVIDER=resend

# Resend (https://resend.com/api-keys) – potřeba jen když EMAIL_PROVIDER=resend.
# Bez vlastní ověřené domény v Resendu (RESEND_FROM_EMAIL zůstane na sandboxu
# onboarding@resend.dev) smí Resend posílat jen na e-mail vlastníka účtu, ne
# komukoli – pro to je potřeba ověřit doménu na resend.com/domains.
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# Gmail SMTP – potřeba jen když EMAIL_PROVIDER=gmail. Na rozdíl od Resendu bez
# vlastní domény jde poslat komukoliv, ne jen vlastníkovi účtu.
# GMAIL_ADDRESS: účet, ze kterého se bude posílat (např. odbaveni@gmail.com).
# GMAIL_APP_PASSWORD: NE běžné heslo do účtu – vygeneruj na
#   https://myaccount.google.com/apppasswords (vyžaduje zapnuté dvoufázové
#   ověření na tom Google účtu). Vloží se sem 16znakový kód bez mezer.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
