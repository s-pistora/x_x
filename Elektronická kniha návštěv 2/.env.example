# Zkopíruj tento soubor jako ".env" a doplň skutečné hodnoty. Nikdy needituj
# přímo .env.example a nikdy .env necommituj do gitu (obsahuje tajné klíče).

# OCR ------------------------------------------------------------------------
# 0 = obecná extrakce jména/příjmení z libovolné občanky (ZNAMI_LIDE prázdný/
#     vypnutý whitelist). 1 (výchozí v kódu) = pozná jen lidi ze ZNAMI_LIDE
#     v ocr_processor.py, u ostatních vrátí prázdné jméno k ruční opravě.
OCR_STRICT_WHITELIST=0

# SMS notifikace ------------------------------------------------------------
# false (výchozí) = SMS se jen vypíší do konzole/logu (mock, bez Twilio účtu).
# true            = odesílají se opravdové SMS přes Twilio (vyžaduje pip install twilio
#                    a platné údaje níže).
SMS_ENABLED=false

# Minimální počet vteřin mezi dvěma SMS na stejné číslo (rate limiting proti spamu).
SMS_COOLDOWN_SECONDS=10

# Twilio (https://console.twilio.com) – potřeba jen když SMS_ENABLED=true
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
